# Non-secret configuration. For NEW deployments run generate_secrets.py.
APP_ENV=production
APP_DB_NAME=appdb
SECRETS_DIR=./.secrets
PKI_DIR=./certs
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Docker daemon log directory (rootful Linux Engine default).
DOCKER_LOG_ROOT=/var/lib/docker/containers

# P3: stable identity origin (must match certificate SAN and browser reachability).
IDENTITY_HOSTNAME=https://identity.example.com
IDENTITY_TLS_DIR=./identity-certs
# SPA redirect/origin are exact values in docker/keycloak/florasecure-realm.json.
# Replace localhost only with reviewed deployment-specific HTTPS URLs before first import.
