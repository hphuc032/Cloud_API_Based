# Browser calls same-origin /api through Vite during local development.
VITE_API_BASE_URL=
# Server-side proxy target. Set a remote lab URL here if needed.
API_PROXY_TARGET=https://localhost:8443

# P4: exact verified HTTPS Keycloak origin (realm/client are fixed in the adapter).
VITE_OIDC_URL=https://localhost:9443
# Optional verified HTTPS Vite development listener; supply runtime cert/key paths.
VITE_TLS_CERT=
VITE_TLS_KEY=

# P5: enable only in an authorized disposable lab, never a shared deployment.
VITE_SECURITY_LAB=false
# Optional reviewed HTTPS monitoring URL; empty means no monitoring link.
VITE_GRAFANA_URL=
