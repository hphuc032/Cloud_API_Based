{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "p6-security",
      "folder": "Security",
      "interval": "10s",
      "rules": [
        {
          "uid": "p6-jwt-rejections",
          "title": "P6 jwt-rejections",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 120,
                "to": 0
              },
              "datasourceUid": "florasecure-loki",
              "model": {
                "expr": "sum(count_over_time({service=~\"kong|backend\"} | json | event_type=~\"token_rejected\" [1m])) or vector(0)",
                "refId": "A",
                "queryType": "instant",
                "instant": true
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "A",
                "refId": "C",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        5
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "type": "query",
                    "query": {
                      "params": [
                        "C"
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "NoData",
          "execErrState": "Error",
          "for": "30s",
          "annotations": {
            "summary": "Security event threshold exceeded; inspect request IDs without exporting credentials.",
            "runbook_url": "docs/monitoring/alert-response.md"
          },
          "labels": {
            "severity": "warning",
            "phase": "p6",
            "environment": "lab"
          },
          "isPaused": false
        },
