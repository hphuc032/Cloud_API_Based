{
  "uid": "florasecure-overview",
  "title": "API Security Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Gateway requests",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "florasecure-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=~\"kong\"} | json | event_type=~\"http_request|token_rejected|rate_limited|upstream_error\" [$__interval]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Authentication rejection",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "florasecure-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=~\".+\"} | json | event_type=~\"token_rejected\" [$__interval]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Authorization denial",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "florasecure-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=~\"backend\"} | json | event_type=~\"rbac_denied|ownership_denied\" [$__interval]))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Rate limit",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "florasecure-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=~\"kong\"} | json | event_type=~\"rate_limited\" [$__interval]))"
        }
      ]
    },
    {
      "id": 5,
      "title": "Service errors",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "florasecure-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=~\".+\"} | json | event_type=~\"service_error|upstream_error\" [$__interval]))"
        }
      ]
    },
    {
      "id": 6,
      "title": "All gateway requests",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "florasecure-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=\"kong\"}[1m]))"
        }
      ]
    },
    {
      "id": 7,
      "title": "2xx responses",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "florasecure-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=\"kong\"} | json | status_code >= 200 and status_code < 300 [1m]))"
        }
      ]
    },
    {
      "id": 8,
      "title": "4xx responses",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "florasecure-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=\"kong\"} | json | status_code >= 400 and status_code < 500 [1m]))"
        }
      ]
    },
    {
      "id": 9,
      "title": "5xx responses",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "florasecure-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=\"kong\"} | json | status_code >= 500 [1m]))"
        }
      ]
    },
    {
      "id": 10,
      "title": "Application mean latency (milliseconds)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "florasecure-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time({service=\"backend\"} | json | unwrap duration_ms | __error__=\"\" [1m])"
        }
      ]
    },
    {
      "id": 11,
      "title": "Denials per second by application route template",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "florasecure-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate({service=\"backend\"} | json | event_type=~\"rbac_denied|ownership_denied\" [5m]))"
        }
      ]
    },
    {
      "id": 99,
      "title": "Coverage limitations",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Missing telemetry: explicit mTLS cause, independent availability probes, storage metrics, separate account-lockout reasons. Recent ingestion is not proof of service health. See security-events.md."
      }
    }
  ]
}
